# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The site's own URL. Not a secret: the text agent puts it in replies.
# @type=url @public
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Chrome extension ID the sync page messages. Ask for a fixed manifest key so it stays stable.
# @public @required=false
EXTENSION_ID=

# Best Buy Products API key (developer.bestbuy.com). Without it listings.search returns [].
# @required=false
BESTBUY_API_KEY=

# Anthropic API key for storefront photos (Claude Haiku). Without it photos get "text the name".
# @required=false
ANTHROPIC_API_KEY=
