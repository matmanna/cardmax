# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The site's own URL. Not a secret: the text agent puts it in replies.
# @type=url @public
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Chrome extension ID the sync page messages. Ask for a fixed manifest key so it stays stable.
# @public @required=false
EXTENSION_ID=

# Best Buy Products API key (developer.bestbuy.com). Without it listings.search returns [].
# @required=false
BESTBUY_API_KEY=

# Storefront photo reader: "anthropic" (Claude Haiku) or "gemini". Defaults to
# whichever key is set, Anthropic first. Without either key photos get "text the name".
# @required=false @type=enum(anthropic, gemini)
VISION_PROVIDER=

# Anthropic API key for storefront photos (Claude Haiku).
# @required=false @sensitive
ANTHROPIC_API_KEY=

# Gemini API key for storefront photos. Use a billing-enabled project: on the
# free tier Google may use inputs to improve its products, with human review.
# @required=false @sensitive
GEMINI_API_KEY=

# Gemini model id. Defaults to gemini-3.8-flash.
# @required=false
GEMINI_MODEL=

# Twilio account SID for the SMS/MMS text agent. Without both Twilio vars /api/agent/twilio returns 404.
# @required=false
TWILIO_ACCOUNT_SID=

# Public URL Twilio calls, if it differs from BETTER_AUTH_URL (a tunnel or proxy). Signatures are checked against it.
# @required=false @type=url
TWILIO_WEBHOOK_URL=

# Twilio auth token. Verifies webhook signatures and downloads and deletes MMS media.
# @required=false @sensitive
TWILIO_AUTH_TOKEN=

# Enables /api/agent/dev, an unauthenticated "text as any number" endpoint for local testing.
# Never set this on a deployment.
# @type=boolean @public
AGENT_DEV_WEBHOOK=false

# Spectrum (Photon) project ID for the iMessage channel.
# @required=false
SPECTRUM_PROJECT_ID=

# Spectrum (Photon) project secret.
# @required=false @sensitive
SPECTRUM_PROJECT_SECRET=

# Signing secret returned once by POST /projects/{id}/webhooks/. The Photon
# webhook route is off until the project ID, secret and this are all set.
# @required=false @sensitive
SPECTRUM_WEBHOOK_SECRET=
