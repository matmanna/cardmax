# Base URL of the Pointmaxx web app. Release builds default to https://pointmaxx.ing.
# In dev (wxt serve), leave unset to use sample listings offline.
WXT_API_URL=http://localhost:3001
# Origin allowed to message the extension through externally_connectable.
# Release builds default to https://pointmaxx.ing, dev to http://localhost:3001.
# The manifest key in wxt.config.ts pins the extension ID to
# idhdmipfkciggnihmadkcofgachjneng. Set the web app's EXTENSION_ID to that.
WXT_WEB_ORIGIN=http://localhost:3001
