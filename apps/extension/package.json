{
	"name": "@cardmax/extension",
	"version": "0.0.0",
	"private": true,
	"description": "Cardmax browser extension",
	"type": "module",
	"scripts": {
		"dev": "wxt --port 5555",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:e2e": "WXT_E2E=1 wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"postinstall": "wxt prepare",
		"check-types": "tsc --noEmit",
		"test:e2e": "bun run build:e2e && playwright test"
	},
	"dependencies": {
		"@cardmax/core": "workspace:*",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@fontsource/instrument-serif": "5.3.0",
		"@orpc/client": "catalog:",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@wxt-dev/module-react": "^1.1.5",
		"typescript": "catalog:",
		"web-ext": "^10.5.0",
		"wxt": "^0.21.3"
	}
}
